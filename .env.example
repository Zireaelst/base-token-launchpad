# Copy to .env (git-ignored). Never put private keys here: deploys use the Foundry keystore `deployer`.
# Server-only values must never be prefixed NEXT_PUBLIC_.

# --- contracts (packages/contracts) -------------------------------------------------------------
# Dedicated Base mainnet RPC (server-side only). Used for fork tests and deploy scripts.
BASE_RPC_URL=
# Platform treasury: a Safe deployed on Base. Receives 40% of fees. Must be a contract.
PLATFORM_TREASURY=
# Etherscan v2 API key (also covers BaseScan), for contract verification.
ETHERSCAN_API_KEY=
# Optional: opening tick for every launch (default 198050, ~2.5 ETH starting FDV).
INITIAL_TICK=
# Optional: CREATE2 salt for our contracts (default 0x0).
LAUNCHPAD_SALT=

# --- sdk / web -----------------------------------------------------------------------------------
# Builder Code from base.dev > Settings > Builder Codes. Appended to every transaction (ERC-8021).
NEXT_PUBLIC_BUILDER_CODE=

# --- indexer (apps/indexer) ----------------------------------------------------------------------
# Base RPC for Ponder (server-side only).
PONDER_RPC_URL_8453=
# Postgres connection string (Neon via Vercel Marketplace). Leave empty locally to use PGlite.
DATABASE_URL=
# Deploy block of our contracts (start of indexing).
START_BLOCK=
# Our deployment: either a JSON file with the five addresses, or the five env vars below.
LAUNCHPAD_DEPLOYMENT=
TOKEN_FACTORY=
BENEFICIARY_VAULT=
FEE_SPLITTER=
INSTANT_LAUNCH_STRATEGY=
UNIVERSAL_ROUTER_STRATEGY=
# Team / test wallets excluded from /stats and grant metrics (comma separated).
EXCLUDED_WALLETS=

# --- web (apps/web) ------------------------------------------------------------------------------
# Brand name (owner decision pending) and public site URL (OG/metadata base).
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_SITE_URL=
# Our deployment addresses (public data). See docs/deployment.md.
NEXT_PUBLIC_TOKEN_FACTORY=
NEXT_PUBLIC_BENEFICIARY_VAULT=
NEXT_PUBLIC_FEE_SPLITTER=
NEXT_PUBLIC_INSTANT_LAUNCH_STRATEGY=
NEXT_PUBLIC_UNIVERSAL_ROUTER_STRATEGY=
NEXT_PUBLIC_PLATFORM_TREASURY=
# Server-only: the RPC (proxied at /api/rpc) and the indexer API (proxied at /api/indexer).
# BASE_RPC_URL is shared with the contracts section above.
INDEXER_URL=
# Server-only: Vercel Blob token for image uploads and reports.
BLOB_READ_WRITE_TOKEN=
# Moderation: blocked words (comma separated) and hidden token addresses (comma separated).
MODERATION_BLOCKLIST=
HIDDEN_TOKENS=
# Gas sponsorship for a creator's first launch (smart wallets). Off by default.
NEXT_PUBLIC_SPONSOR_FIRST_LAUNCH=false
CDP_PAYMASTER_URL=
